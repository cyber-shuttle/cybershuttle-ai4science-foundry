# Optional. Every value below is already the default in scripts/common.sh.
# Copy to .env (in this directory) only if you want different locations.

# Scratch directory for large files: OpenFold source, conda env, weights.
OPENFOLD_WORK=$HOME/scratch/openfold-6kwc
OPENFOLD_ENV=$OPENFOLD_WORK/conda-env
OPENFOLD_DIR=$OPENFOLD_WORK/openfold
ALIGNMENT_DIR=$OPENFOLD_WORK/alignments_no_templates
TEMPLATE_MMCIF_DIR=$OPENFOLD_WORK/template_mmcif
CHECKPOINT_PATH=$OPENFOLD_WORK/params/finetuning_no_templ_ptm_1.pt

# FASTA_DIR and OUTPUT_DIR default to inputs/ and results/run-<job id>/ in this recipe.
CONFIG_PRESET=model_3_ptm
