# Settings for the FourCastNet workflow. Load from the repo root with: source scripts/fourcastnet_config.env

# Cluster (PACE ICE). Check yours with: sacctmgr -nP show assoc user=$USER
export SBATCH_PARTITION="coc-gpu"
export SBATCH_ACCOUNT="coc"
export SBATCH_QOS="coc-ice"
export SBATCH_GRES="gpu:a100:1"
export MODULES="miniforge/24.3.0-0"
export SCRATCH_DIR="$HOME/scratch"

# Model source
export FCN_REPO_URL="https://github.com/NVlabs/FourCastNet.git"
export FCN_REPO_COMMIT="93360c1720a9f97aabf970689f21c9fad8737788"
export FCN_WEIGHTS_URL="https://portal.nersc.gov/project/m4134/FCN_weights_v0"

# Software
export PYTHON_VERSION="3.11"
export CONDA_ENV_NAME="fcn"

# Paths (all in scratch, home is too small)
export WORK_DIR="$SCRATCH_DIR/fourcastnet-work"
export CONDA_ENV_PREFIX="$WORK_DIR/conda-env"
export FCN_REPO_DIR="$WORK_DIR/FourCastNet"
export WEIGHTS_DIR="$WORK_DIR/weights"
export DATA_DIR="$WORK_DIR/data"
export PIP_CACHE_DIR="$WORK_DIR/cache/pip"
export CONDA_PKGS_DIRS="$WORK_DIR/cache/conda-pkgs"

# Run settings
export INIT_TIMES="2018-01-01T00:00:00 2018-07-01T00:00:00"  # 2018 is the paper's test year
export NSTEPS=20        # 20 steps x 6 h = 5 days
export SMOKE_NSTEPS=2
export EVAL_VARS="z500 t850 t2m u10m"
export SEED=0

# Logs, sacct output and validation results (committed)
export EVIDENCE_DIR="registry/models/climate/fourcastnet/evidence"
